# kb.env -- kb-serve config + secrets, machine-local, NEVER committed.
#
# Real location: ~/.knowledgebase/kb.env (gitignored; see .gitignore's
# "Knowledgebase vault" section). Copy this file there and edit it:
#
#   cp ~/Projects/agent-workbench/scripts/kb-container/kb.env.example ~/.knowledgebase/kb.env
#   chmod 600 ~/.knowledgebase/kb.env
#
# Every value below is optional; the defaults in scripts/kb_config.py
# apply to anything left unset. The deterministic put/clip/query/atomize
# path never reads any of this: without a key, atomization falls back to
# the heading splitter, /enrich is a clean no-op, and retrieval is
# keyword-only.

# Master switch for the LLM enrichment pass. 0 = /enrich is a clean
# no-op (zero network calls). Must be 1 to spend any model calls.
KB_ENRICH=0

# Any OpenAI-compatible chat/completions endpoint. OpenRouter is the
# default because it fronts many providers/models behind one API.
KB_LLM_BASE_URL=https://openrouter.ai/api/v1

# Any model string your KB_LLM_BASE_URL provider accepts.
KB_LLM_MODEL=openai/gpt-4o-mini

# --- API key: pick ONE of the two modes below -----------------------
#
# Mode 1: static value (simplest, least secure -- sits in this file).
# KB_LLM_API_KEY=sk-or-v1-REPLACE_ME
#
# Mode 2: vault command (preferred). kb-serve.py runs this exact command
# and uses its stdout as the key; wins over KB_LLM_API_KEY if both are
# set. Works with any vault CLI, not just Proton Pass -- e.g. `pass show
# openrouter`, `op read op://vault/openrouter/api-key`, `gopass show
# openrouter`. See ~/.claude/skills/proton-pass-cli/SKILL.md for the
# exact pass-cli invocation and its PROTON_PASS_SESSION_DIR /
# PROTON_PASS_AGENT_REASON requirements.
# KB_LLM_API_KEY_CMD="pass-cli item view --vault-name MachineSecrets --item-title openrouter --field api-key"

# --- Embeddings (hybrid retrieval) ----------------------------------
#
# UNSET BY DEFAULT, and that is a working configuration: with no model
# here, `POST /reindex` stores no vectors and `GET /query` is pure FTS5.
# Set it to any embedding model your KB_LLM_BASE_URL provider accepts to
# turn on the vector half of retrieval; the API key above is reused.
# Vectors are derived like the FTS5 index is -- rebuild them from the
# vault alone at any time with `agent-workbench kb index`.
# KB_EMBED_MODEL=openai/text-embedding-3-small
