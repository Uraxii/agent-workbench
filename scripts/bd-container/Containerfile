FROM python@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG BD_VERSION=1.1.0
ARG BD_ARCHIVE=beads_${BD_VERSION}_linux_amd64.tar.gz
ARG BD_BASE_URL=https://github.com/gastownhall/beads/releases/download/v${BD_VERSION}
RUN curl -fsSL -o /tmp/${BD_ARCHIVE} ${BD_BASE_URL}/${BD_ARCHIVE} \
    && curl -fsSL -o /tmp/checksums.txt ${BD_BASE_URL}/checksums.txt \
    && cd /tmp && grep " ${BD_ARCHIVE}\$" checksums.txt | sha256sum -c - \
    && tar -xzf ${BD_ARCHIVE} -C /usr/local/bin bd \
    && chmod +x /usr/local/bin/bd \
    && rm -f /tmp/${BD_ARCHIVE} /tmp/checksums.txt

WORKDIR /app
COPY bd-svc.py ./

EXPOSE 9101

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('BD_SVC_PORT','9101')+'/health', timeout=3)"]

ENTRYPOINT ["python3", "/app/bd-svc.py", "run"]
