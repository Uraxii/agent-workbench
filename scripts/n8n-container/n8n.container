[Unit]
Description=n8n workflow automation (Community, self-hosted)
After=network-online.target

[Container]
# Official n8n image, PINNED BY DIGEST (never :latest, never a floating
# tag) for reproducibility. This is the multi-arch manifest-list (OCI
# image index) digest for n8n 2.31.5, so Podman still selects the correct
# per-arch manifest underneath it. Re-pin deliberately on upgrade:
#   podman pull docker.io/n8nio/n8n:<new-tag>
#   podman inspect --format '{{.RepoDigests}}' docker.io/n8nio/n8n:<new-tag>
# and take the index (schemaVersion 2, mediaType image.index) digest.
# Podman auto-pulls this digest on first start if it is not already local.
Image=docker.io/n8nio/n8n@sha256:cda6bafc7bb4873533e7affb82d1bd47282a7614bdf83242c2293f8ff281261a
ContainerName=n8n

# Run as the invoking user (rootless keep-id). The official image runs as
# its own user `node` (uid 1000); this host user is also uid 1000, so
# keep-id lines the two up and the sqlite DB + config n8n writes into the
# bind-mounted data dir below come out owned by the real host user.
# Verified: after a live run, database.sqlite and config (mode 0600) were
# owned by the host user.
User=%U
Group=%U
UserNS=keep-id

# n8n's own port default is 5678; no reason to deviate. The container
# binds 0.0.0.0 inside its OWN network namespace, and PublishPort below
# restricts the host side to loopback only -- Podman's normal, intended
# model (container binds broadly, host-side publish narrows), identical to
# kb-serve/review-serve. This keeps n8n's network namespace isolated
# rather than sharing the host's.
Environment=N8N_PORT=5678
Environment=N8N_LISTEN_ADDRESS=0.0.0.0
# Public REST API is already enabled by upstream default (this env var
# defaults to false); pinned explicitly so a future upstream default flip
# cannot silently disable it. Agents authenticate to it via the
# X-N8N-API-KEY header -- see .claude/skills/agent-workbench/SKILL.md.
Environment=N8N_PUBLIC_API_DISABLED=false
PublishPort=127.0.0.1:5678:5678

# Reachability fix (pasta backend, podman 5.8.2 rootless). n8n workflows
# must reach two HOST-loopback-bound services: ComfyUI at
# host.containers.internal:8188 and review-serve at
# host.containers.internal:9099. Under pasta, host.containers.internal
# resolves to 169.254.1.2 but is NOT forwarded to the host's 127.0.0.1 by
# default (pasta's default map-host-loopback targets the LAN gateway, not
# 169.254.1.2), so a plain container gets connection-refused. Passing
# pasta --map-host-loopback,169.254.1.2 makes pasta translate that address
# to the host loopback. Verified: curl to host.containers.internal:8188/
# and :9099/ from inside the container both return 200, with the
# container's network namespace still isolated (not Network=host).
Network=pasta:--map-host-loopback,169.254.1.2

# Only the n8n data dir is mounted -- no broad $HOME bind. The official
# image writes its sqlite DB + config to /home/node/.n8n; N8N_USER_FOLDER
# defaults there. Host data dir persists the DB, config, and the
# encryption key across restarts.
Volume=%h/.local/share/n8n:/home/node/.n8n:rw

# Hardening. Verified live: ReadOnly rootfs + a /tmp tmpfs + the data
# volume above ran migrations, served /healthz 200, and wrote the sqlite DB
# with NO read-only (EROFS) errors -- but n8n also writes static-asset
# build output to /home/node/.cache (separate from N8N_USER_FOLDER, which
# stays under the mounted .n8n data dir above). Without a tmpfs there, n8n
# crash-loops seconds after "n8n ready" with:
#   Error: ENOENT: no such file or directory, mkdir '/home/node/.cache'
# Cache contents are disposable, so a second tmpfs (not the persistent
# volume) is the right fix.
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/home/node/.cache
NoNewPrivileges=true
DropCapability=ALL

# N8N_ENCRYPTION_KEY (REQUIRED: encrypts stored credentials in n8n's own
# sqlite DB; must persist across restarts, or existing stored credentials
# are orphaned) is resolved on the HOST by the ExecStartPre below and
# written to a tmpfs env file under %t (the user's XDG runtime dir),
# regenerated on every start, gone at logout/reboot. The raw key is never
# written to persistent disk, never baked into the image, never logged.
# Same rationale as kb-serve's %t/kb-serve.env block.
EnvironmentFile=%t/n8n.env

# SELinux (enforcing on this host) would otherwise deny the data-dir bind
# mount, or force a recursive relabel of it. Read-only rootfs + cap-drop +
# no-new-privileges are the compensating controls for this one narrow
# mount, same call as kb-serve/review-serve.
SecurityLabelDisable=true

# Quadlet-level health check (this image is not built by us, so there is
# no Containerfile HEALTHCHECK to bake). /healthz is n8n's liveness
# endpoint (verified 200 on a live run). busybox wget is present in the
# image; curl is not.
HealthCmd=wget -q -O /dev/null http://127.0.0.1:5678/healthz || exit 1
HealthInterval=30s
HealthTimeout=5s
# First boot runs DB migrations; give it headroom before failures count.
HealthStartPeriod=30s
HealthRetries=3

[Service]
# Build the tmpfs env file on the HOST before the container starts:
# resolve N8N_ENCRYPTION_KEY (static value OR vault _CMD) via the standalone
# resolver, which prints exactly one `N8N_ENCRYPTION_KEY=<value>` line and
# never logs the value. `umask 077` plus the redirect keeps the file 0600.
# n8n-secret.py resolve-secret handles a missing n8n.env / unset key
# gracefully (prints the key with an empty value, exit 0) -- but note that
# n8n itself REQUIRES a non-empty key, so an unconfigured deploy will fail
# fast at n8n startup, which is the intended loud failure.
ExecStartPre=/bin/sh -c 'umask 077 && %h/Projects/agent-workbench/scripts/n8n-container/n8n-secret.py resolve-secret --data-dir %h/.local/share/n8n > %t/n8n.env'
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=default.target
