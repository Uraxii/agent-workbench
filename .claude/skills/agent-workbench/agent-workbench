#!/usr/bin/env python3
"""agent-workbench -- single executable entrypoint for the pure-Python
agent-workbench CLI.

This file is the ONE host-discoverable executable the skill ships. It puts
its own directory on sys.path so the `cli` package next to it imports
cleanly, then hands off to cli.main.main(). All real logic lives in the
`cli/` package modules (one per subcommand); this shim carries none.

Subcommands (see each cli/*.py module docstring):
    kb              knowledgebase vault ops (port of scripts/kb.sh)
    hub             bd (beads) board hub ops (port of scripts/beads-hub.sh)
    board           bdui web front-end lifecycle (port of scripts/board-ui.sh)
    init-workspace  scaffold a repo's agent workspace (port of
                    scripts/init-agent-workspace.sh)
    deploy          build + run the kb-serve / review-serve containers
                    (port of deploy/agent-workbench/agent-workbench)
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from cli.main import main  # noqa: E402  (path shim must precede this import)

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
